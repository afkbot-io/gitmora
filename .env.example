# Copy to <private application state>/compose.env AFTER deployment init; chmod 600.
# deployment up/down/status/admin automatically select that file.
# These are Docker Compose interpolation settings, not application runtime secrets.
# Explicit values exported in the calling shell take precedence (normal Compose behavior).
GITMORA_PUBLIC_HOST=gitmora.example.com
GITMORA_REALM=gitmora
GITMORA_CLIENT_ID=gitmora
GITMORA_PRIVATE_SUBNET=172.30.88.0/24
GITMORA_PRIVATE_GATEWAY=172.30.88.1
GITMORA_POSTGRES_IMAGE=gitmora-postgres:18.6-security1

# Optional same-host Tasktopia overlay; also set its exact MCP URL in runtime.env.
# GITMORA_TASKTOPIA_HOST=tasks.example.com

# Optional custom GitLab overlay (choose instead of compose.gitlab-com.yaml).
# GITMORA_GITLAB_URL=https://gitlab.example.com:8443/gitlab
# GITMORA_GITLAB_AUTHORITY=gitlab.example.com:8443
# GITMORA_GITLAB_VISIBILITY=private
# Optional CA overlay; PEM contains system roots + corporate CA, never a private key.
# GITMORA_GITLAB_CA_BUNDLE=/srv/gitmora/config/trusted-ca.pem

# Optional GitHub Enterprise overlay (can coexist with GitHub.com).
# GITMORA_GITHUB_ENTERPRISE_URL=https://github.example.com
# GITMORA_GITHUB_ENTERPRISE_AUTHORITY=github.example.com:443
# GITMORA_GITHUB_ENTERPRISE_VISIBILITY=public

# Optional remote Tasktopia overlay (choose instead of the same-host overlay).
# GITMORA_TASKTOPIA_URL=https://tasks.example.com/mcp
# GITMORA_TASKTOPIA_AUTHORITY=tasks.example.com:443
# GITMORA_TASKTOPIA_VISIBILITY=public

# WORKGRAPH_STATE_DIR, WORKGRAPH_IMAGE and WORKGRAPH_HTTP_PORT are pinned by
# deployment init's --directory/--image/--port, then supplied by the operator CLI.
# GITMORA_IDENTITY_* values are generated from identity-server init flags and
# persisted identity.json; do not copy them into application runtime.env.
