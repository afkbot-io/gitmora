# Non-secret installation settings. PostgreSQL credentials are supplied by compose.yaml through file secrets.
WORKGRAPH_PUBLIC_URL=https://gitmora.tasktopia.online
# Also apply this policy with identity-server configure/up using the same env value.
WORKGRAPH_REGISTRATION_ENABLED=false
WORKGRAPH_ENCRYPTION_ACTIVE_KEY=primary
WORKGRAPH_ENCRYPTION_KEYS_FILE=/run/secrets/encryption_keys
WORKGRAPH_TASKTOPIA_ALLOWLIST=https://tasktopia.online/mcp

# OIDC configuration remains explicit; enable only after configuring the identity provider.
# WORKGRAPH_OIDC_ISSUER=https://gitmora.tasktopia.online/auth/realms/gitmora
# WORKGRAPH_OIDC_CLIENT_ID=gitmora
# WORKGRAPH_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
