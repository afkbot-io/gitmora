# Copy to <private application state>/runtime.env; chmod 600.
# Application runtime settings. Compose interpolation belongs in compose.env.
# Public origin must match DNS, TLS, nginx, the provider and CLI --server exactly.
WORKGRAPH_PUBLIC_URL=https://gitmora.example.com
# Apply the SAME value with identity-server configure/up; default is false.
WORKGRAPH_REGISTRATION_ENABLED=false
WORKGRAPH_ENCRYPTION_ACTIVE_KEY=primary
WORKGRAPH_ENCRYPTION_KEYS_FILE=/run/secrets/encryption_keys

# Optional Tasktopia exact endpoints. Leave absent if not connected.
# Remote Docker routing: prefer compose.tasktopia-custom.yaml, which sets both values.
# WORKGRAPH_TASKTOPIA_ALLOWLIST=https://tasks.example.com/mcp
# WORKGRAPH_TASKTOPIA_PROXY_URL=http://tasktopia-egress:8080

# Optional HTTP MCP browser Origin allowlist. Stdio CLI/MCP does not require it.
# WORKGRAPH_MCP_ALLOWED_ORIGINS=https://your-mcp-client.example.com

# Ordinary workers share this file: keep OIDC issuer/client/secret/session options
# in the API-only compose.identity-auth.yaml overlay (or a reviewed API override).
# See docs/configuration.md for EVERY supported variable, direct/native settings,
# file-secret formats, defaults, Compose precedence and optional TLS trust bundles.
# Database URL is set by compose.yaml via WORKGRAPH_DATABASE_URL_FILE.
# Never set both a secret's direct variable and its _FILE form, even to empty text.
